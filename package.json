{
  "name": "bitgolf",
  "version": "0.0.1",
  "description": "A global peer-to-peer code-golf game for your terminal",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://onzw8zpoon5ux1o8sap7kazrporj3hew3dhnqki66dcnjtubtmqo",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare \"test/**/*.test.js\"",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "generate-bootstrap-key": "node scripts/generate-bootstrap-key.js",
    "build": "node scripts/build.js",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "node scripts/make-target.js darwin-arm64",
    "make:darwin-x64": "node scripts/make-target.js darwin-x64",
    "make:linux-arm64": "node scripts/make-target.js linux-arm64",
    "make:linux-x64": "node scripts/make-target.js linux-x64",
    "make:win32-arm64": "node scripts/make-target.js win32-arm64",
    "make:win32-x64": "node scripts/make-target.js win32-x64"
  },
  "dependencies": {
    "autobase": "7.28.1",
    "bare-ansi-escapes": "2.2.3",
    "bare-fs": "4.7.2",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-readline": "1.3.1",
    "bare-semver": "1.0.3",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hypercore-crypto": "3.7.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "author": "0xDmitry",
  "license": "MIT"
}
